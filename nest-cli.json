{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "builder": "tsc",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "introspectComments": false,
          "dtoFileNameSuffix": [".dto.ts", ".entity.ts"]
        }
      }
    ],    
    "assets": [
      {
        "include": "**/*.hbs",
        "outDir": "dist/src",
        "watchAssets": false
      }
    ],
    "watchAssets": false
  }
}
