// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

enum UserProfileType {
  CLIENT
  CONSULTANT
}

enum Gender {
  MALE
  FEMALE
}

enum AvailabilityType {
  CUSTOM
  WEEKLY
}

enum AvailabilityPeriod {
  WEEKDAYS
  WEEKENDS
  MIXED
}

enum DateLabel {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id             String     @id @default(uuid())
  avatar         String?
  email          String     @unique
  password       String
  firstName      String
  lastName       String
  type           UserType
  gender         String?
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  firstTimeLogin Boolean    @default(false)
  lastLoginAt    DateTime?
  userRoles      UserRole[]

  // Ecommerce relations
  pharmacies           Pharmacy[]
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  prescriptions        Prescription[]
  subscriptions        Subscription[]
  userProfiles         UserProfile[]
  transactions         Transaction[]
  calendarIntegrations CalendarIntegration[]
  favorites            Favorite[]
  blogPosts            BlogPost[]
  pushSubscriptions    PushSubscription[]

  @@index([email])
}

model UserProfile {
  id                     String                  @id @default(uuid())
  userId                 String
  type                   UserProfileType
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userProfileClients     UserProfileClient[]
  userProfileConsultants UserProfileConsultant[]
}

model UserProfileClient {
  id                      String                 @id @default(uuid())
  coverName               String?
  referral                String?
  channel                 String?
  useCoverName            Boolean?               @default(false)
  symptoms                String[]               @default([])
  hasBookedSession        Boolean?               @default(false)
  sessions                Session[]
  userProfileId           String
  userProfile             UserProfile            @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?
  userProfileConsultant   UserProfileConsultant? @relation(fields: [userProfileConsultantId], references: [id])
  userProfileConsultantId String?

  @@index([userProfileId])
  @@index([deletedAt])
}

model UserProfileConsultant {
  id                 String                   @id @default(uuid())
  introVideo         String?
  bio                String?
  rate               Float?
  jobTitle           String?
  areaOfExpertise    String[]
  yearsOfExperience  Int?
  faith              String?
  clients            UserProfileClient[]
  availability       ConsultantAvailability[]
  availabilityPeriod AvailabilityPeriod?
  offerFaithTherapy  Boolean?
  hasSetAvailability Boolean                  @default(false)
  rating             Float?
  timezone           String? // Consultant's timezone (e.g., 'Africa/Lagos')
  sessions           Session[]
  userProfile        UserProfile?             @relation(fields: [userProfileId], references: [id])
  userProfileId      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?

  @@index([userProfileId])
  @@index([deletedAt])
}

model ConsultantAvailability {
  id           String                @unique @default(uuid())
  type         AvailabilityType
  consultantId String
  consultant   UserProfileConsultant @relation(fields: [consultantId], references: [id])
  dayOfWeek    DateLabel?
  dateString   String?
  date         DateTime?
  slots        Int[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@unique([name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  value       String   @unique
  description String?
  group       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// Ecommerce Models

enum OrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  READY_FOR_DISPATCH
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELED
  FAILED_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  ORDER
  SESSION
  RECURRING_ORDER
  SUBSCRIPTION
  REFUND
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum OrderRecurringFrequency {
  WEEKLY
  MONTHLY
}

enum ProductType {
  OTC
  POM
}

enum StockMovementType {
  RESERVE
  COMMIT
  RELEASE
  ADJUSTMENT
  RECONCILIATION
}

enum SessionStatus {
  COMPLETED
  UPCOMING
  PENDING
  CANCELED
  DECLINED
  PENDING_APPROVAL
  APPROVED
}

enum SessionType {
  INDIVIDUAL
  COUPLE
  CONSULTATION
}

enum OrganizationSponsor {
  CLIENT
  ORG
  HMO
  ORG_CLIENT
}

enum PrescriptionType {
  DOCTOR
  PATIENT
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String     @unique
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
  @@index([isActive])
}

model Product {
  id                   String          @id @default(uuid())
  name                 String
  sku                  String          @unique
  description          String?
  price                Int // in Naira
  currency             String          @default("NGN")
  requiresPrescription Boolean         @default(false)
  productType          ProductType     @default(OTC)
  categoryId           String?
  category             Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId              String?
  brand                Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images               String[]        @default([])
  dosages              String[]        @default([])
  packageSizes         String[]        @default([])
  howToUse             String?
  ingredients          String[]        @default([])
  pharmacyAdvise       String?
  specification        String?
  isActive             Boolean         @default(true)
  featured             Boolean         @default(false)
  stockQuantity        Int             @default(0)
  stockReserved        Int             @default(0)
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  cartItems            CartItem[]
  orderItems           OrderItem[]
  subscriptions        Subscription[]
  stockMovements       StockMovement[]
  favorites            Favorite[]

  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([featured])
}

model Pharmacy {
  id          String   @id @default(uuid())
  name        String
  address     Json // {line1, city, state, postalCode, country}
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId])
  @@index([isActive])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String?
  country    String   @default("Nigeria")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id                 String                   @id @default(uuid())
  userId             String?
  user               User?                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryAddressId  String?
  deliveryAddress    Address?                 @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  // Guest information for anonymous orders
  guestFirstName     String?
  guestLastName      String?
  guestEmail         String?
  guestPhone         String?
  // Guest address for anonymous orders
  guestAddressLine1  String?
  guestAddressLine2  String?
  guestCity          String?
  guestState         String?
  guestPostalCode    String?
  guestCountry       String?
  totalAmount        Int // in Naira
  deliveryFee        Int                      @default(0) // in Naira
  currency           String                   @default("NGN")
  paymentStatus      PaymentStatus            @default(PENDING)
  orderStatus        OrderStatus              @default(PENDING)
  prescriptionStatus PrescriptionStatus?
  paymentReference   String?
  paymentProvider    String? // paystack, flutterwave
  notes              String?
  isRecurring        Boolean                  @default(false)
  recurringFrequency OrderRecurringFrequency?
  recurringDate      DateTime? // When the recurring order schedule was established
  nextRunDate        DateTime? // When the next recurring order should be created
  paymentRetryCount  Int                      @default(0) // Number of payment retry attempts
  isRecurringActive  Boolean                  @default(true) // Whether recurring order is active (false after 3 failed retries)
  items              OrderItem[]
  prescriptions      Prescription[]
  transactions       Transaction[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([paymentReference])
  @@index([guestEmail])
  @@index([isRecurring])
  @@index([recurringFrequency])
  @@index([nextRunDate])
  @@index([isRecurringActive])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int // price at time of order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model Prescription {
  id         String             @id @default(uuid())
  orderId    String?
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy String // user id who uploaded
  fileUrl    String
  status     PrescriptionStatus @default(PENDING)
  reviewedBy String? // clinician/pharmacist id
  notes      String?

  // Patient info (for patient-submitted prescriptions)
  patientName     String?
  patientLocation String?
  patientEmail    String?
  patientPhone    String?
  additionalNote  String?

  // Doctor info (for doctor-submitted prescriptions)
  prescriberName     String?
  prescriberEmail    String?
  prescriberPhone    String?
  prescriberHospital String?
  prescriberLocation String?
  hospitalName       String?
  drugName           String?
  dosage             String?

  prescriberType PrescriptionType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model Subscription {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId            String
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  frequency            SubscriptionFrequency
  nextRunDate          DateTime
  quantity             Int                   @default(1)
  isActive             Boolean               @default(true)
  autoCharge           Boolean               @default(false)
  paymentAuthorization String? // encrypted payment authorization token
  sessions             Session[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([nextRunDate])
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Int // positive for additions, negative for deductions
  reservedBefore Int? // snapshot for audit
  reservedAfter  Int?
  quantityBefore Int // snapshot for audit
  quantityAfter  Int
  orderId        String? // reference to order if applicable
  reason         String? // description of movement (e.g., "Order #123", "Manual adjustment")
  createdBy      String? // user/system that created this movement
  createdAt      DateTime          @default(now())
  // Append-only table - no updates or deletes allowed at DB level

  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
  @@index([type])
}

model Session {
  id                  String                @id @default(uuid())
  clientId            String
  client              UserProfileClient     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consultantId        String
  consultant          UserProfileConsultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  status              SessionStatus         @default(PENDING)
  sessionType         SessionType           @default(INDIVIDUAL)
  scheduledDate       DateTime
  scheduledDateString String                @unique
  meetingId           String?
  meetingUrl          String?
  metadata            Json?
  clientTimezone      String?
  note                String?
  prescriptionNote    String? // Prescription note - editable by consultant, visible to client
  sessionNote         String? // Session note/report - consultant only
  rescheduled         Boolean               @default(false)
  changeLog           Json? // Array of status changes
  deleted             Boolean               @default(false)
  deletedAt           DateTime?

  // Calendar integration
  calendarEventId       String? // Google Calendar event ID
  calendarIntegrationId String? // Reference to which calendar integration was used
  calendarIntegration   CalendarIntegration? @relation(fields: [calendarIntegrationId], references: [id], onDelete: SetNull)

  // Payment & Quota
  paidBy         OrganizationSponsor @default(CLIENT)
  subscriptionId String?
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  giftId         String?
  gift           SessionGift?        @relation(fields: [giftId], references: [id], onDelete: SetNull)
  hmoId          String?
  hmoNumber      String?

  // Relations
  participants       SessionParticipant[]
  invitees           SessionInvitee[]
  activities         SessionActivity[]
  rescheduleRequests SessionRescheduleRequest[]
  review             SessionReview?
  transactions       Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([consultantId])
  @@index([status])
  @@index([scheduledDate])
  @@index([scheduledDateString])
  @@index([sessionType])
  @@index([subscriptionId])
  @@index([giftId])
  @@index([deleted])
  @@index([calendarEventId])
  @@index([calendarIntegrationId])
}

model SessionParticipant {
  id           String    @id @default(uuid())
  sessionId    String
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String?
  email        String
  name         String
  meetingToken String? // Cloudflare Realtime Kit auth token for this participant
  joined       Boolean   @default(false)
  joinedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sessionId, email])
  @@index([sessionId])
  @@index([userId])
}

model SessionInvitee {
  id         String    @id @default(uuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  email      String
  name       String
  token      String    @unique
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([sessionId, email])
  @@index([sessionId])
  @@index([token])
}

model SessionActivity {
  id               String    @id @default(uuid())
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activityType     String // JOIN, LEAVE, END, etc.
  userId           String?
  metadata         Json?
  meetingStartTime DateTime?
  meetingEndTime   DateTime?
  duration         Int? // in seconds
  createdAt        DateTime  @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model SessionRescheduleRequest {
  id                  String    @id @default(uuid())
  sessionId           String
  session             Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedBy         String // userId
  requestedDate       DateTime
  requestedDateString String
  reason              String?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  respondedBy         String?
  respondedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([requestedBy])
}

model SessionReview {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String?
  reviewedBy String // userId (client)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sessionId])
  @@index([rating])
}

model SessionGift {
  id            String    @id @default(uuid())
  giftFrom      String // userId who gifted
  giftTo        String? // userId who received (optional for pending)
  giftToEmail   String // email of recipient
  sessionsLeft  Int       @default(0)
  totalSessions Int
  message       String?
  isRedeemed    Boolean   @default(false)
  redeemedAt    DateTime?
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([giftFrom])
  @@index([giftTo])
  @@index([giftToEmail])
  @@index([isRedeemed])
}

model CalendarIntegration {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String // 'google', 'outlook', 'apple', etc.
  accessToken   String // Encrypted access token
  refreshToken  String? // Encrypted refresh token
  tokenExpiry   DateTime? // Token expiry timestamp
  isConnected   Boolean   @default(true)
  providerEmail String? // Email associated with the calendar account
  calendarId    String? // Primary calendar ID (for Google: usually 'primary')
  metadata      Json? // Additional provider-specific data
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncedAt  DateTime? // Last time calendar was synced
  sessions      Session[] // Sessions using this calendar integration

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isConnected])
}

model Transaction {
  id                String            @id @default(uuid())
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type              TransactionType
  reference         String            @unique // Internal reference (e.g., order ID, session ID)
  providerReference String            @unique // Payment provider reference (e.g., Paystack reference)
  provider          String // paystack, flutterwave, stripe, etc.
  status            TransactionStatus @default(PENDING)
  amount            Int // Amount in Naira
  currency          String            @default("NGN")
  description       String?

  // Related entity IDs
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Metadata from payment provider
  metadata         Json? // Full response from payment provider
  providerResponse Json? // Detailed provider response
  providerMetadata Json? // Additional provider metadata

  // Payment details
  paymentMethod     String? // card, bank, ussd, etc.
  paymentChannel    String? // paystack channel used
  authorizationCode String? // For recurring payments
  customerCode      String? // Payment provider customer code
  customerEmail     String?
  customerName      String?

  // Webhook information
  webhookEvent   String? // Event type from provider webhook
  webhookPayload Json? // Full webhook payload

  // Timestamps
  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?

  // Error tracking
  errorMessage String?
  errorCode    String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([providerReference])
  @@index([provider])
  @@index([orderId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  image           String?
  content         String // Markdown content
  excerpt         String? // Short description/excerpt
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  published       Boolean   @default(false)
  publishedAt     DateTime?
  views           Int       @default(0)
  metaTitle       String? // SEO meta title
  metaDescription String? // SEO meta description
  tags            String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([authorId])
  @@index([published])
  @@index([publishedAt])
  @@index([createdAt])
}

/// A browser Web Push (VAPID) subscription belonging to an admin user. One row
/// per browser/device an admin has enabled notifications on.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The push service URL. Unique per browser installation.
  endpoint      String    @unique
  /// Client public key used to encrypt the payload.
  p256dh        String
  /// Client auth secret used to encrypt the payload.
  auth          String
  userAgent     String?
  /// Consecutive delivery failures. Reset on every successful send.
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
