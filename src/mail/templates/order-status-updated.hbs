{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}}{{#if lastName}} {{lastName}}{{/if}},</p>
                        <p class="body paragrapy-spacing">
                            We're writing to inform you that there has been an update to your order status.
                        </p>

                        <div
                            style="background-color: #fff3cd; border: 1px solid #856404; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #856404;">Order Update</h3>
                            <p style="margin-bottom: 10px;"><strong>Order ID:</strong> {{orderId}}</p>
                            <p style="margin-bottom: 10px;"><strong>Order Date:</strong> {{orderDate}}</p>
                            {{#if newOrderStatus}}
                            <p style="margin-bottom: 10px;">
                                <strong>Order Status:</strong>
                                {{#if previousOrderStatus}}
                                <span style="text-decoration: line-through; color: #666;">{{previousOrderStatus}}</span>
                                →
                                {{/if}}
                                <span style="font-weight: bold; color: #28a745;">{{newOrderStatus}}</span>
                            </p>
                            {{/if}}
                            {{#if newPaymentStatus}}
                            <p style="margin-bottom: 0;">
                                <strong>Payment Status:</strong>
                                {{#if previousPaymentStatus}}
                                <span
                                    style="text-decoration: line-through; color: #666;">{{previousPaymentStatus}}</span>
                                →
                                {{/if}}
                                <span style="font-weight: bold; color: #28a745;">{{newPaymentStatus}}</span>
                            </p>
                            {{/if}}
                        </div>

                        {{#if statusMessage}}
                        <div
                            style="background-color: {{statusMessageColor}}; border: 1px solid {{statusMessageBorderColor}}; padding: 15px; border-radius: 8px; margin: 20px 0;">
                            <p style="margin: 0; color: {{statusMessageTextColor}};">
                                {{{statusMessage}}}
                            </p>
                        </div>
                        {{/if}}

                        <p class="body paragrapy-spacing"><strong>Order Details:</strong></p>
                        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">{{itemsSummary}}</pre>
                            <p style="margin-top: 15px; margin-bottom: 0; font-weight: bold;">Total: {{totalAmount}}</p>
                        </div>

                        <p class="body paragrapy-spacing">
                            If you have any questions about your order status or need assistance, please contact our
                            support team at
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a> and include your Order ID
                            ({{orderId}}) for faster assistance.
                        </p>

                        <p class="body paragrapy-spacing">
                            Thank you for choosing Medvax!
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}