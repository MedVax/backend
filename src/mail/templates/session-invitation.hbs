{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{name}},</p>
                        <p class="body paragrapy-spacing">
                            You have been invited to participate in a session with {{consultantName}}.
                        </p>

                        <div style="background-color: #d1ecf1; border: 1px solid #0c5460; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #0c5460;">Session Invitation</h3>
                            <p style="margin-bottom: 10px;"><strong>Date & Time:</strong> {{sessionDate}}</p>
                            <p style="margin-bottom: 0;"><strong>Consultant:</strong> {{consultantName}}</p>
                        </div>

                        {{#if meetingUrl}}
                        <div style="background-color: #e7f3ff; border: 1px solid #0066cc; padding: 15px; border-radius: 8px; margin: 20px 0;">
                            <p style="margin-bottom: 5px;"><strong>Meeting Link:</strong></p>
                            <p style="margin: 0;">
                                <a href="{{meetingUrl}}" style="color: #007bff; text-decoration: none; font-weight: bold; font-size: 16px;">Join Meeting</a>
                            </p>
                        </div>
                        {{/if}}

                        <p class="body paragrapy-spacing">
                            Please confirm your participation and make sure you're available at the scheduled time. 
                            You'll receive a reminder email 24 hours and 1 hour before the session.
                        </p>

                        <p class="body paragrapy-spacing">
                            If you have any questions, please contact our support team at 
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
                        </p>

                        <p class="body paragrapy-spacing">
                            We look forward to having you join this session!
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}

