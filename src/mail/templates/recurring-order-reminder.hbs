{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}},</p>
                        <p class="body paragrapy-spacing">
                            This is a friendly reminder that your recurring order will be processed tomorrow on {{nextDeliveryDate}}.
                        </p>

                        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0;">Order Details</h3>
                            <p style="margin-bottom: 10px;"><strong>Order ID:</strong> {{orderId}}</p>
                            <p style="margin-bottom: 10px;"><strong>Frequency:</strong> {{frequency}}</p>
                            <p style="margin-bottom: 10px;"><strong>Next Delivery Date:</strong> {{nextDeliveryDate}}</p>
                            <p style="margin-bottom: 10px;"><strong>Items:</strong></p>
                            <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">{{itemsSummary}}</pre>
                            <p style="margin-top: 10px; margin-bottom: 0;"><strong>Total Amount:</strong> {{totalAmount}}</p>
                        </div>

                        <p class="body paragrapy-spacing">
                            Your order will be automatically processed and charged according to your recurring order settings. 
                            If you need to make any changes or cancel this order, please contact us before the processing date.
                        </p>

                        <p class="body paragrapy-spacing">
                            If you have any questions or concerns, please don't hesitate to contact our support team at 
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}
