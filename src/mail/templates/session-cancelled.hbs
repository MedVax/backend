{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}}{{#if lastName}} {{lastName}}{{/if}},</p>
                        <p class="body paragrapy-spacing">
                            Your session with {{consultantName}} scheduled for {{sessionDate}} has been cancelled.
                        </p>

                        <div style="background-color: #f8d7da; border: 1px solid #721c24; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #721c24;">Session Cancelled</h3>
                            <p style="margin-bottom: 10px;"><strong>Original Date:</strong> {{sessionDate}}</p>
                            <p style="margin-bottom: 10px;"><strong>Consultant:</strong> {{consultantName}}</p>
                            <p style="margin-bottom: 0;"><strong>Reason:</strong> {{reason}}</p>
                        </div>

                        <p class="body paragrapy-spacing">
                            If you would like to book a new session, please visit your dashboard or contact our support team.
                        </p>

                        <p class="body paragrapy-spacing">
                            If you have any questions about this cancellation or need to reschedule, please contact our support team at 
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
                        </p>

                        <p class="body paragrapy-spacing">
                            Thank you for using Medvax.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}

