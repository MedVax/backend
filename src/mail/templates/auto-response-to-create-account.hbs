{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">
                            Failed to process ticket / conversation with subject <b>{{subject}}</b>
                        </p>

                        <p class="body paragrapy-spacing">You are currently not registered as an agent with your
                            organization <b style="text-transform: capitalize;">{{organizationName}}</b> on
                            Medvax. To contribute or create a ticket, you'll need to be registered
                            as an agent.
                        </p>

                        <p class="body paragrapy-spacing">
                            Reach out to our support at <b>support@medvax.com</b> and request for an account
                            creation
                            and resend your ticket / conversation.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}