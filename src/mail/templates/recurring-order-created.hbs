{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}}{{#if lastName}} {{lastName}}{{/if}},</p>
                        <p class="body paragrapy-spacing">
                            Great news! Your recurring order has been successfully set up and will be automatically processed on a {{frequency}} basis.
                        </p>

                        <div style="background-color: #d1ecf1; border: 1px solid #0c5460; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #0c5460;">Recurring Order Active ✓</h3>
                            <p style="margin-bottom: 10px;"><strong>Order ID:</strong> {{orderId}}</p>
                            <p style="margin-bottom: 10px;"><strong>Frequency:</strong> {{frequency}}</p>
                            <p style="margin-bottom: 0;"><strong>Next Delivery:</strong> {{nextDeliveryDate}}</p>
                        </div>

                        <p class="body paragrapy-spacing"><strong>Order Details:</strong></p>
                        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">{{itemsSummary}}</pre>
                            <p style="margin-top: 15px; margin-bottom: 0; font-weight: bold;">Total per delivery: {{totalAmount}}</p>
                        </div>

                        <p class="body paragrapy-spacing">
                            <strong>How it works:</strong>
                        </p>
                        <ul style="margin-left: 20px;">
                            <li class="body">Your order will be automatically created and processed every {{frequency}} cycle.</li>
                            <li class="body">You'll receive a payment link before each delivery to complete your payment.</li>
                            <li class="body">We'll send you a reminder email one day before each scheduled delivery.</li>
                            <li class="body">You can cancel or modify your recurring order at any time by contacting our support team.</li>
                        </ul>

                        <p class="body paragrapy-spacing">
                            Your recurring order is now active, and your first delivery is scheduled for <strong>{{nextDeliveryDate}}</strong>. 
                            We'll ensure your medications are ready and delivered on time.
                        </p>

                        <p class="body paragrapy-spacing">
                            If you have any questions about your recurring order or need to make any changes, please contact our support team at 
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a> and include your Order ID ({{orderId}}) for faster assistance.
                        </p>

                        <p class="body paragrapy-spacing">
                            Thank you for choosing Medvax for your recurring medication needs!
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}
