{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Hi, {{firstName}}
                        </p>
                        <p class="body paragrapy-spacing">We are pleased to inform you that the scheduled process
                            <b>{{jobName}}</b> has
                            been completed successfully.
                        </p>
                        <p class="body paragrapy-spacing">If you have any questions, please feel free to reach out to
                            us.
                        </p>


                        <table border="0" cellspacing="0" cellpadding="0"
                            style="width: 100%;max-width: 200px; margin: 0 auto">
                            <tr>
                                <td align="center" style="border-radius: 16px;" bgcolor="#262262">
                                    <a href={{link}} target="_blank"
                                        style="color: #ffffff; display: inline-block; font-size: 16px; padding: 8px 20px; text-decoration: none;">View
                                        Details</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}