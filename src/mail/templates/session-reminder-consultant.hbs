{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}}{{#if lastName}} {{lastName}}{{/if}},</p>
                        {{#if is24HourReminder}}
                        <p class="body paragrapy-spacing">
                            This is a reminder that you have a session with {{clientName}} scheduled for tomorrow.
                        </p>
                        {{else}}
                        <p class="body paragrapy-spacing">
                            This is a reminder that you have a session with {{clientName}} scheduled in 1 hour.
                        </p>
                        {{/if}}

                        <div style="background-color: #d1ecf1; border: 1px solid #0c5460; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #0c5460;">
                                {{#if is24HourReminder}}
                                ⏰ Session Tomorrow
                                {{else}}
                                ⏰ Session in 1 Hour
                                {{/if}}
                            </h3>
                            <p style="margin-bottom: 10px;"><strong>Date & Time:</strong> {{sessionDate}}</p>
                            <p style="margin-bottom: 0;"><strong>Client:</strong> {{clientName}}</p>
                        </div>

                        <div style="background-color: #e7f3ff; border: 1px solid #0066cc; padding: 15px; border-radius: 8px; margin: 20px 0;">
                            <p style="margin-bottom: 10px;"><strong>Meeting Link:</strong></p>
                            <p style="margin-bottom: 15px;">
                                <a href="{{meetingUrl}}" style="color: #007bff; text-decoration: none; font-weight: bold; font-size: 16px; padding: 10px 20px; background-color: #007bff; color: white; border-radius: 5px; display: inline-block;">Join Meeting Now</a>
                            </p>
                            <p style="margin: 0; font-size: 14px; color: #666;">
                                💡 Please review the client's information in your dashboard and ensure you're in a quiet, professional setting.
                            </p>
                        </div>

                        <p class="body paragrapy-spacing">
                            Please make sure you're prepared and available at the scheduled time. 
                            If you need to make any changes, please do so as soon as possible.
                        </p>

                        {{#unless is24HourReminder}}
                        <div style="background-color: #fff3cd; border: 1px solid #856404; padding: 15px; border-radius: 8px; margin: 20px 0;">
                            <p style="margin: 0; color: #856404;">
                                <strong>⏰ Final Reminder:</strong> Your session is in 1 hour! Please ensure everything is ready.
                            </p>
                        </div>
                        {{/unless}}

                        <p class="body paragrapy-spacing">
                            If you have any questions or need assistance, please contact our support team at 
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
                        </p>

                        <p class="body paragrapy-spacing">
                            Thank you for your commitment to providing excellent care!
                        </p>
                    </td>
                </tr>
            </table>
        </td>
        </td>
    </tr>
</table>

{{> footer }}

