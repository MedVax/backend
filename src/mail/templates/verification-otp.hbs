{{> head }}

{{> header}}


<table cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td align="center">
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td>
            <p class="body paragrapy-spacing">Hi,</p>
            <p class="body paragrapy-spacing"> Welcome to Fraudspect! We're thrilled to start your onboarding process.
            </p>
            <p class="body paragrapy-spacing"> To ensure the security of your account and protect your personal
              information,
              we need to verify your email address. To complete the verification process,
              please enter the following one-time password (OTP) into the field provided on our website:</p>
          </td>
        </tr>
      </table>
      <table width="100%" style="margin:20px 0px">
        <tbody>
          <tr>
            <td style="padding:10px;background:#faf9f5;border-radius:.5rem;  text-align:center">
              <strong style="font-size:24px; letter-spacing: 8px;color:#000000">{{otp}}</strong>
            </td>
          <tr>
        </tbody>
      </table>
      <p class="body paragrapy-spacing">
        This OTP will expire in 10 minutes, so please make sure to enter it as soon as possible.
      </p>
    </td>
  </tr>
</table>


{{> footer}}