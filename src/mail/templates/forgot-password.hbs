{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}},</p>
                        <p class="body paragrapy-spacing">You have requested to reset your password. Please click the
                            button below to proceed with the password reset process:
                        </p>

                        <table border="0" cellspacing="0" cellpadding="0"
                            style="width: 100%;max-width: 200px; margin: 0 auto">
                            <tr>
                                <td align="center" style="border-radius: 16px;" bgcolor="#262262">
                                    <a href={{forgotPasswordLink}} target="_blank"
                                        style="color: #ffffff; display: inline-block; font-size: 16px; padding: 8px 20px; text-decoration: none;">Reset
                                        Password</a>
                                </td>
                            </tr>
                        </table>
                        <p class="body paragrapy-spacing text-center">or copy reset link:
                            {{forgotPasswordLink}}
                        </p>
                        <p class="body paragrapy-spacing">If you did not request this password reset, please ignore this
                            email. Your password will not be changed unless you click the button above to confirm the
                            reset.
                        </p>

                    </td>


                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}