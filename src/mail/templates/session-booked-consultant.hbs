{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}}{{#if lastName}} {{lastName}}{{/if}},</p>
                        <p class="body paragrapy-spacing">
                            You have a new session(s) booked with {{clientName}}.
                        </p>

                        <div
                            style="background-color: #d1ecf1; border: 1px solid #0c5460; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            <h3 style="margin-top: 0; color: #0c5460;">New Session(s) Booked</h3>
                            <p style="margin-bottom: 10px;"><strong>Client:</strong> {{clientName}}</p>
                            <p style="margin-bottom: 10px;"><strong>Session Type:</strong> {{sessionType}}</p>
                            <p style="margin-bottom: 0;">Please ensure you're available at the scheduled time{{#if
                                multipleSessions}}s{{/if}}.</p>
                        </div>

                        <p class="body paragrapy-spacing"><strong>Session Details:</strong></p>
                        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;">
                            {{#each sessionDetails}}
                            <div
                                style="margin-bottom: 15px; padding-bottom: 15px; {{#unless @last}}border-bottom: 1px solid #ddd;{{/unless}}">
                                <p style="margin-bottom: 5px;"><strong>Date & Time:</strong> {{date}}</p>
                                {{#if meetingUrl}}
                                <p style="margin-bottom: 0;">
                                    <strong>Meeting Link:</strong>
                                    <a href="{{meetingUrl}}" style="color: #007bff; text-decoration: none;">Join
                                        Meeting</a>
                                </p>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>

                        <p class="body paragrapy-spacing">
                            A reminder email will be sent to you 24 hours and 1 hour before the session.
                            Please make sure to review the client's information in your dashboard before the session.
                        </p>

                        <p class="body paragrapy-spacing">
                            If you have any questions or concerns, please contact our support team at
                            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
                        </p>

                        <p class="body paragrapy-spacing">
                            Thank you for providing excellent care!
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}