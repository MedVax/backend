{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Dear {{firstName}},</p>
                        <p class="body paragrapy-spacing">We wanted to let you know that your account credit balance is
                            approaching the low threshold.
                        </p>
                        <p class="body paragrapy-spacing">Account Details:</p>
                        <ul>
                            <li class="body"><strong>Current Credit Balance:</strong> {{creditBalance}}</li>
                            <li class="body"><strong>Low Credit Threshold:</strong> {{creditThreshold}}</li>
                        </ul>

                        <p class="body paragrapy-spacing">To ensure uninterrupted access to our services, we recommend
                            topping up your credit as soon as possible. You can easily add more credit by logging into
                            your account</p>

                        <table border="0" cellspacing="0" cellpadding="0"
                            style="width: 100%;max-width: 200px; margin: 0 auto">
                            <tr>
                                <td align="center" style="border-radius: 16px;" bgcolor="#262262">
                                    <a href={{loginUrl}} target="_blank"
                                        style="color: #ffffff; display: inline-block; font-size: 16px; padding: 8px 20px; text-decoration: none;">Log
                                        In</a>
                                </td>
                            </tr>
                        </table>

                        <p class="body text-center" style="margin-top: 5px">or copy login url: {{loginUrl}}</p>

                        <p class="body paragrapy-spacing">By staying ahead, you’ll continue to enjoy all the benefits
                            without any interruptions. If you have any questions or need assistance, feel free to
                            reach out to our support team at {{supportEmail}}.</p>
                        <p class="body paragrapy-spacing">Thank you for choosing Fraudspect. We’re here to ensure your
                            experience is seamless.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}