{{> head }}
{{> header }}

<table cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td>
                        <p class="body paragrapy-spacing">Hi,</p>
                        <p class="body paragrapy-spacing">
                            You have been invited by <b>{{invitedBy}}</b> to
                            join <b>{{organizationName}}</b>, to accept the invitation and join our team, please click
                            the button below:
                        </p>


                        <table border="0" cellspacing="0" cellpadding="0"
                            style="width: 100%;max-width: 230px; margin: 0 auto;margin-top: 10px">
                            <tr>
                                <td align="center" style="border-radius: 16px;" bgcolor="#262262">
                                    <a href={{inviteLink}} target="_blank"
                                        style="color: #ffffff; display: inline-block; font-size: 16px; padding: 8px 20px; text-decoration: none;">Accept
                                        Invite</a>
                                </td>
                            </tr>
                        </table>

                        <p class="body paragrapy-spacing">Note: invitation expires 42 hours from now</p>,

                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

{{> footer }}